{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pytest:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(ruff:*)",
      "Bash(openspec:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch:*)",
      "Bash(git stash list)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(pwd)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Read(**)",
      "Edit(tests/**)",
      "Edit(src/**)",
      "Edit(openspec/**)",
      "Edit(inputs/**)",
      "Edit(variables.yaml)",
      "Edit(pyproject.toml)",
      "Edit(conftest.py)",
      "Edit(.env.example)",
      "Edit(README.md)",
      "Edit(CLAUDE.md)",
      "Write(tests/**)",
      "Write(src/**)",
      "Write(openspec/**)",
      "Write(reports/**)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(rm -f:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(chmod 777:*)",
      "Edit(.env)",
      "Write(.env)",
      "Read(.env)"
    ],
    "ask": [
      "Bash(pip:*)",
      "Bash(npm:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git merge:*)",
      "Bash(git tag:*)",
      "Edit(.claude/**)",
      "Edit(.gitignore)",
      "Write(.gitignore)",
      "Write(pyproject.toml)"
    ]
  }
}
