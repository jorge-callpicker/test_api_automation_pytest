# .env.example
#
# Copia este archivo a `.env` y reemplaza cada [REQUIERE RESPUESTA: ...]
# con el valor real del ambiente. El archivo `.env` NO se versiona
# (está en .gitignore). Este archivo (`.env.example`) sí se versiona.
#
# Convención de nombres:
#   {{GLB-token_admin}}  ↔  GLB_TOKEN_ADMIN
#   {{GLB-url_base}}     ↔  GLB_URL_BASE
# (Guiones en YAML/tests → underscore + UPPERCASE en env.)

# --- Variables globales del ambiente bajo prueba -----------------------

GLB_URL_BASE=[REQUIERE RESPUESTA: URL base del ambiente de pruebas, sin slash final. Ejemplo: https://api.chatdev.callpicker.com]
GLB_TOKEN_ADMIN=[REQUIERE RESPUESTA: valor del header api-access-token para un usuario con rol Admin válido en el ambiente. Ejemplo: eyJhbGciOiJIUzI1NiIs...]

# --- Credenciales OAuth por rol (POST /oauth/token) --------------------
# Solo son obligatorias para los roles presentes en
# `variables.yaml → globals → GLB-oauth_roles`. Si un rol se retira de ese
# mapa, sus dos variables dejan de ser requeridas (pero no está mal dejarlas
# con placeholder). Regla de mapeo: <rol>.upper().replace("-", "_").

GLB_CLIENT_ID_TANGO=[REQUIERE RESPUESTA: CLIENT ID del rol Tango (Super Administrador), sección API del panel de administración de Callpicker. Ejemplo: CU.3344.243413443]
GLB_CLIENT_SECRET_TANGO=[REQUIERE RESPUESTA: CLIENT SECRET del rol Tango, misma sección. Ejemplo: 7ghdssgaj22lmnms8822sq190d]

GLB_CLIENT_ID_ADMIN=[REQUIERE RESPUESTA: CLIENT ID del rol Admin. Ejemplo: CU.3344.243413444]
GLB_CLIENT_SECRET_ADMIN=[REQUIERE RESPUESTA: CLIENT SECRET del rol Admin]

GLB_CLIENT_ID_SUPERVISOR=[REQUIERE RESPUESTA: CLIENT ID del rol Supervisor]
GLB_CLIENT_SECRET_SUPERVISOR=[REQUIERE RESPUESTA: CLIENT SECRET del rol Supervisor]

GLB_CLIENT_ID_ASISTENTE=[REQUIERE RESPUESTA: CLIENT ID del rol Asistente]
GLB_CLIENT_SECRET_ASISTENTE=[REQUIERE RESPUESTA: CLIENT SECRET del rol Asistente]

GLB_CLIENT_ID_CUSTOMER=[REQUIERE RESPUESTA: CLIENT ID del rol Customer]
GLB_CLIENT_SECRET_CUSTOMER=[REQUIERE RESPUESTA: CLIENT SECRET del rol Customer]

GLB_CLIENT_ID_EXTENSION=[REQUIERE RESPUESTA: CLIENT ID del rol Extension]
GLB_CLIENT_SECRET_EXTENSION=[REQUIERE RESPUESTA: CLIENT SECRET del rol Extension]

GLB_CLIENT_ID_EXTENSION_SUPERVISORA=[REQUIERE RESPUESTA: CLIENT ID del rol Extension Supervisora]
GLB_CLIENT_SECRET_EXTENSION_SUPERVISORA=[REQUIERE RESPUESTA: CLIENT SECRET del rol Extension Supervisora]

# --- Credenciales de base de datos (SQLAlchemy Core, AUTOCOMMIT) -------
# Se usan exclusivamente para aserciones de estado post-request. El
# usuario debe tener SELECT sobre las tablas involucradas (mínimo
# `Templates Gupshup`). No se requieren permisos de escritura.

DB_HOST=[REQUIERE RESPUESTA: host de la BD del ambiente. Ejemplo: db.chatdev.callpicker.com]
DB_PORT=[REQUIERE RESPUESTA: puerto de la BD. Ejemplo: 3306]
DB_NAME=[REQUIERE RESPUESTA: nombre de la BD que contiene la tabla Templates Gupshup. Ejemplo: callpicker_chat]
DB_USER=[REQUIERE RESPUESTA: usuario de BD con permisos SELECT sobre las tablas involucradas. Ejemplo: qa_readonly]
DB_PASSWORD=[REQUIERE RESPUESTA: password del usuario anterior]
