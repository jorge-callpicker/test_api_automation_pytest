# .env.example
#
# Copia este archivo a `.env` y reemplaza cada [REQUIERE RESPUESTA: ...]
# con el valor real del ambiente. El archivo `.env` NO se versiona
# (está en .gitignore). Este archivo (`.env.example`) sí se versiona.
#
# Convención de nombres:
#   {{GLB-token_admin}}  ↔  GLB_TOKEN_ADMIN
#   {{GLB-url_base}}     ↔  GLB_URL_BASE
# (Guiones en YAML/tests → underscore + UPPERCASE en env.)

# --- Variables globales del ambiente bajo prueba -----------------------

GLB_URL_BASE=[REQUIERE RESPUESTA: URL base del ambiente de pruebas, sin slash final. Ejemplo: https://api.chatdev.callpicker.com]
GLB_TOKEN_ADMIN=[REQUIERE RESPUESTA: valor del header api-access-token para un usuario con rol Admin válido en el ambiente. Ejemplo: eyJhbGciOiJIUzI1NiIs...]

# --- Variables del ambiente Chatwoot (audit logs) -----------------------
# Usadas por framework/audit_logs.py para consultar
# GET /api/v1/accounts/{account_id}/audit_logs. Host y token propios de
# Chatwoot: NO son GLB_URL_BASE/GLB_TOKEN_ADMIN (esos son de
# Gupshup/Templates) ni GLB-url_cp_api (panel Callpicker Chat).

GLB_URL_CHATWOOT=[REQUIERE RESPUESTA: URL base de la instancia Chatwoot del ambiente de pruebas, sin slash final. Ejemplo: https://chat.callpicker.com]
GLB_TOKEN_CHATWOOT_ADMIN=[REQUIERE RESPUESTA: valor del header api_access_token de Chatwoot para un usuario Admin válido, obtenido desde el perfil de usuario o la consola de Rails. Ejemplo: eyJhbGciOiJIUzI1NiIs...]

# --- Credenciales de login de Chat API (rutina de autenticación) ------
# Usadas por framework/auth.py para obtener el token de sesión
# encadenando login -> selectAccount, según el rol solicitado.

USR_SADMIN=[REQUIERE RESPUESTA: username (correo) de un usuario SuperAdmin válido en el ambiente. Ejemplo: superadmin@test.com]
PSW_SADMIN=[REQUIERE RESPUESTA: password del usuario SuperAdmin anterior]
USR_ADMIN=[REQUIERE RESPUESTA: username (correo) de un usuario Admin válido en el ambiente. Ejemplo: admin@test.com]
PSW_ADMIN=[REQUIERE RESPUESTA: password del usuario Admin anterior]

# --- Credenciales de base de datos (SQLAlchemy Core, AUTOCOMMIT) -------
# Se usan exclusivamente para aserciones de estado post-request. El
# usuario debe tener SELECT sobre las tablas involucradas (mínimo
# `Templates Gupshup`). No se requieren permisos de escritura.

DB_HOST=[REQUIERE RESPUESTA: host de la BD del ambiente. Ejemplo: db.chatdev.callpicker.com]
DB_PORT=[REQUIERE RESPUESTA: puerto de la BD. Ejemplo: 3306]
DB_NAME=[REQUIERE RESPUESTA: nombre de la BD que contiene la tabla Templates Gupshup. Ejemplo: callpicker_chat]
DB_USER=[REQUIERE RESPUESTA: usuario de BD con permisos SELECT sobre las tablas involucradas. Ejemplo: qa_readonly]
DB_PASSWORD=[REQUIERE RESPUESTA: password del usuario anterior]
